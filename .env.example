# Easy ABC — ตัวอย่าง env (คัดลอกเป็น .env.local แล้วเติมค่าจริง)
# ⚠️ ห้าม commit .env.local (มี secret) — ไฟล์นี้เก็บชื่อตัวแปรอย่างเดียว

# ── better-auth ──
# secret สุ่มยาว ๆ: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL เต็มของแอป (dev เว้นว่างได้ better-auth จะ infer จาก request; prod ต้องตั้ง)
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (Google Cloud Console → Credentials → OAuth client ID: Web) ──
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Turso / libSQL ──
# dev: เว้นว่างได้ → ใช้ไฟล์ ./dev.db · prod: ตั้งทั้งคู่ (turso db show / turso db tokens create)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── LINE แจ้งเตือน admin เมื่อมีการชำระเงิน (LINE Messaging API) ──
# Channel access token (long-lived) — LINE Developers Console → channel → Messaging API → Issue
LINE_CHANNEL_ACCESS_TOKEN=
# LINE user id ผู้รับแจ้งเตือน (default = admin ในโค้ด) · channel id 2010602998 ไม่ต้องใช้กับ push API
LINE_ADMIN_USER_ID=Ua61429b9c6633b3a272a295c11eae58d

# ── admin seed (npm run db:seed) ──
# admin ที่ login ได้ทันทีด้วย email+password (ผู้เล่นทั่วไปใช้ Google)
ADMIN_EMAIL=admin@easy-abc.local
ADMIN_PASSWORD=
ADMIN_NAME=ผู้ดูแล Easy ABC

# ── metadata (มีอยู่เดิม) ──
# APP_URL=https://easy-abc.easy-ai.online
